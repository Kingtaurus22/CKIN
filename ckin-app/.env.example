# Salin file ini menjadi .env lalu isi nilainya.

# Koneksi MongoDB (Atlas atau lokal)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=ckin

# Rahasia untuk menandatangani JWT sesi login (minimal 32 karakter acak)
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Cloudinary (dokumen KTP/selfie surveyor dan lampiran chat)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Midtrans Snap (Anggota 2) — ambil dari dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Cadangan URL aplikasi untuk callback Midtrans. Normalnya callback otomatis
# memakai alamat yang sedang dibuka di browser (mis. http://desktop-xxx:3000).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Port server (opsional, default 3000)
PORT=3000

# Chatbot customer service (RAG). Opsional — tanpa key, chatbot tetap menjawab
# dengan mode ekstraktif dari data pesanan & FAQ. Key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
